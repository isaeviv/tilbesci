= simple_form_for(@batch) do |f|
  = f.error_notification
  = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?
  .block.has-background-danger-light
    = f.input :game_id, collection: Game.all.map { |game| [game.name, game.id] }, label_method: :first, value_method: :last
  .block.has-background-primary-light
    = f.input :file, as: :file
  .block
    = f.input :state

  .block
    = f.button :submit