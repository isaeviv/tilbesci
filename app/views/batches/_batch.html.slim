.box id="#{dom_id batch}"
  div
    strong Game:
    =< batch.game.name
  div
    strong Codename:
    =< batch.codename
  div
    strong State:
    =< batch.state
  div
    strong= SourceFile.model_name.human(count: 2)
    - if batch.source_files.any?
      ul
        - batch.source_files.each do |source_file|
          li
            =< source_file.file.filename
            |  (#{source_file.status.humanize})
    - else
      =< t('batches.show.no_files')
  .buttons.mt-3
    = link_to "Show this batch", batch, class: "button is-rounded"
