.box.is-relative.is-clickable id="#{dom_id batch}"
  = link_to "", batch, class: "is-overlay"
  div
    strong #{t(".game")}:
    =< batch.game.name
  div
    strong #{t(".codename")}:
    =< batch.codename
  div
    strong #{t(".state")}:
    =< batch.state
  div
    strong= SourceFile.model_name.human(count: 2)
    - if batch.source_files.any?
      ul
        - batch.source_files.each do |source_file|
          li
            =< source_file.file.filename
            |  (#{source_file.status.text})
    - else
      =< t('batches.show.no_files')
