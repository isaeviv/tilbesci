= cocooned_item do
  .nested-fields.box.mb-3
    - if f.object.persisted? && f.object.file.present?
      span.label
        = f.object.file.file.filename rescue nil
    .field
      = f.label :file, class: 'label'
      .control
        = f.file_field :file
    = cocooned_remove_item_link t('batches.forms.remove_file'), f, class: 'button is-danger is-small is-rounded'
