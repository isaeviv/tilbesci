- if notice
  div data-controller="notifications"
    .notification.is-success data-notifications-target="notice"
      span.delete.is-pulled-right.is-clickable data-action="click->notifications#closeNotice"
      = notice

.box id="#{dom_id @translation}"
  span.is-pulled-right
    = locale_tag @translation.locale
  .block
    h5.title.is-5.mb-1
      = @translation.value
  h6.subtitle.is-6.mb-1
    strong #{t(".translation_key")}:
    = link_to @translation.translation_key.name, @translation.translation_key
  div
    strong #{t(".source")}:
    = @translation.source


div.buttons
  = link_to t(".edit"), edit_translation_path(@translation), class: "button is-link is-rounded"
  = button_to t(".destroy"), @translation, method: :delete, class: "button is-danger is-rounded"
  = link_to t(".back"), translations_path, class: "button is-link is-light is-rounded"
