.box.is-relative.is-clickable id="#{dom_id translation}"
  = link_to "", translation, class: "is-overlay"
  h5.title.is-5.mb-1
    = truncate translation.value, length: 60
  h6.subtitle.is-6.mb-1
    = translation.translation_key.name
  div
    strong #{t(".locale")}:
    = translation.locale
  div
    strong #{t(".state")}:
    = translation.state
  div
    strong #{t(".source")}:
    = translation.source
