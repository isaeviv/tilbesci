div id="#{dom_id translation}"
  div
    strong #{t(".translation_key")}:
    =< translation.translation_key_id
  div
    strong #{t(".locale")}:
    =< translation.locale
  div
    strong #{t(".value")}:
    =< translation.value
  div
    strong #{t(".state")}:
    =< translation.state
  div
    strong #{t(".source")}:
    =< translation.source
