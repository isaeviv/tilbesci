.box.is-relative.is-clickable id="#{dom_id translation}"
  = link_to "", translation, class: "is-overlay" 
  div
    strong #{t(".translation_key")}:
    =< translation.translation_key_id
  div
    strong #{t(".locale")}:
    =< translation.locale
  div
    strong #{t(".value")}:
    =< translation.value
  div
    strong #{t(".state")}:
    =< translation.state
  div
    strong #{t(".source")}:
    =< translation.source
