p style="color: green" = notice

h1.title = t(".title")

#translation_keys
  - @translation_keys.each do |translation_key|
    == render translation_key
    p
      = link_to t(".show"), translation_key, class: "button is-rounded"

= link_to t(".new"), new_translation_key_path, class: "button is-primary is-rounded"
