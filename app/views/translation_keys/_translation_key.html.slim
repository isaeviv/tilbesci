.box.is-relative.is-clickable id="#{dom_id translation_key}"
  = link_to "", translation_key, class: "is-overlay"
  h3.title.is-5.mb-1
    = translation_key.name
    = state_tag_for translation_key
  - if translation_key.description
    div
      strong #{t(".description")}:
      =< translation_key.description
  
  div
    strong #{t(".game")}:
    = translation_key.game.name
