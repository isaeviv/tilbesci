div id="#{dom_id translation_key}"
  div
    strong #{t(".name")}:
    =< translation_key.name
  div
    strong #{t(".description")}:
    =< translation_key.description
  div
    strong #{t(".state")}:
    =< translation_key.state
  div
    strong #{t(".game")}:
    =< translation_key.game_id
  div
    strong #{t(".translated")}:
    =< translation_key.translated
