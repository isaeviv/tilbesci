.box.is-relative.is-clickable id="#{dom_id translation_key}"
  = link_to "", translation_key, class: "is-overlay"
  div
    strong #{t(".name")}:
    =< translation_key.name
  div
    strong #{t(".description")}:
    =< translation_key.description
  div
    strong #{t(".state")}:
    span.tag.is-warning
      =translation_key.state_text
  div
    strong #{t(".game")}:
    = translation_key.game_id
  div
    strong #{t(".translated")}:
    =< translation_key.translated
