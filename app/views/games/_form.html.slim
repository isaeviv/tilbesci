= form_with(model: @game) do |f|
  - if @game.errors.any?
    .message.is-danger
      .message-header
        p = t('errors.messages.not_saved', count: @game.errors.count, resource: @game.class.model_name.human)
      .message-body
        ul
          - @game.errors.full_messages.each do |message|
            li = message

  .field
    = f.label :name, class: 'label'
    .control
      = f.text_field :name, class: 'input'

  .field
    .control
      = f.submit class: 'button is-primary is-rounded'
