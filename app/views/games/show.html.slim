- if notice
  div data-controller="notifications"
    .notification.is-success data-notifications-target="notice"
      span.delete.is-pulled-right.is-clickable data-action="click->notifications#closeNotice"
      = notice

== render @game

div.buttons
  = link_to t(".edit"), edit_game_path(@game), class: "button is-link is-rounded"
  = button_to t(".destroy"), @game, method: :delete, class: "button is-danger is-rounded"
  = link_to t(".back"), games_path, class: "button is-link is-light is-rounded"
